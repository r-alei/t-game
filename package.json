{
  "name": "canli-oyun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TikTok LIVE için three.js tabanlı etkileşimli yayın oyunu",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/main.ts",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.187.0",
    "tiktok-live-connector": "2.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
